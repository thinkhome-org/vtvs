{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vtvs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "build": {
    // Workers Builds runs `wrangler versions upload` with no OpenNext step.
    // Generate the Worker first, unless a previous build already did.
    "command": "test -f .open-next/worker.js || npm run build:worker"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match `name` above — OpenNext uses this to call the same Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vtvs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
