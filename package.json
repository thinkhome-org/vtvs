{
  "name": "vtvs-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev --port 3000",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "npm run build && node ./node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "bulletins:generate": "node scripts/build-bulletin-data.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.36.3",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.2",
    "vite": "8.0.12",
    "wrangler": "4.90.0"
  }
}
